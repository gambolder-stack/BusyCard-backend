{
  "name": "business-card-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Memory-safe print generation engine (PDF + 300DPI PNG + QR + stateless share links) for the Business Card Generator",
  "main": "dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "npm run fonts && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lz-string": "^1.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": ">=0.2.3",
    "@expo-google-fonts/jetbrains-mono": ">=0.2.3",
    "@expo-google-fonts/playfair-display": ">=0.2.3",
    "@expo-google-fonts/space-grotesk": ">=0.2.3",
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
